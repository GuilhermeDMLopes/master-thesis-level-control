# Automatically detect text files.
* text=auto

# Source code and documentation use LF.
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Eclipse 4diac project and type files use LF.
.project text eol=lf
*.sys text eol=lf
*.fbt text eol=lf
*.dev text eol=lf
*.res text eol=lf
*.adp text eol=lf
*.seg text eol=lf
*.typ text eol=lf
*.app text eol=lf
*.xml text eol=lf

# C and C++ source files use LF.
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# PowerShell scripts use Windows line endings.
*.ps1 text eol=crlf

# Binary files must not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.7z binary
*.rar binary
*.exe binary
*.dll binary
forte/preserved-v3h-3_9/external-modules/MPC_V3H/* -text -diff !eol

# Preserve exact final MPC V4 generated and experimental bytes.
forte/preserved-v4/external-modules/MPC_V4/* -text -diff !eol
forte/preserved-v4/build/* -text -diff !eol
forte/preserved-v4/runtimes/mpc-v4-candidate/* -text -diff !eol
data/sample/mpc-v4-target17000-20260829/*.csv -text -diff !eol
data/sample/mpc-v4-target17000-20260829/*.log -text -diff !eol
data/sample/mpc-v4-target17000-20260829/physical-observation.txt -text -diff !eol

# Preserve exact final matched PI experimental bytes.
data/sample/pi-v4-matched-20260901/*.csv -text -diff !eol
data/sample/pi-v4-matched-first-attempt-20260829/*.csv -text -diff !eol
