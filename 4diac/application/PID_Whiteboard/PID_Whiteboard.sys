<?xml version="1.0" encoding="UTF-8"?>
<System Name="PID_Whiteboard" Comment="Synthetic closed-loop example only; unmapped; native validation pending">
	<Application Name="PID_Simulation" Comment="">
		<SubAppNetwork>
			<FB Name="Cycle" Type="E_CYCLE" Comment="" x="300.0" y="300.0">
				<Parameter Name="DT" Value="T#100ms"/>
			</FB>
			<FB Name="Process" Type="PID_DEMO_PROCESS" Comment="" x="2200.0" y="300.0">
			</FB>
			<FB Name="Controller" Type="PID_FLAG" Comment="" x="4400.0" y="300.0">
				<Parameter Name="KP" Value="1.0"/>
				<Parameter Name="KI" Value="0.5"/>
				<Parameter Name="KD" Value="0.1"/>
				<Parameter Name="TS_S" Value="0.1"/>
				<Parameter Name="U_MIN" Value="0.0"/>
				<Parameter Name="U_MAX" Value="10.0"/>
				<Parameter Name="SP" Value="1.0"/>
			</FB>
			<EventConnections>
				<Connection Source="Process.INITO" Destination="Controller.INIT" Comment=""/>
				<Connection Source="Controller.INITO" Destination="Cycle.START" Comment="" dx1="80.0" dx2="80.0" dy="160.0"/>
				<Connection Source="Cycle.EO" Destination="Process.REQ" Comment="" dx1="626.6666666666667"/>
				<Connection Source="Process.CNF" Destination="Controller.REQ" Comment=""/>
				<Connection Source="Controller.CNF" Destination="Process.APPLY" Comment="" dx1="80.0" dx2="80.0" dy="46.66666666666667"/>
				<Connection Source="Process.ERR" Destination="Cycle.STOP" Comment="" dx1="80.0" dx2="80.0" dy="-100.0"/>
				<Connection Source="Controller.ERR" Destination="Cycle.STOP" Comment="" dx1="80.0" dx2="80.0" dy="-100.0"/>
			</EventConnections>
			<DataConnections>
				<Connection Source="Process.Y" Destination="Controller.PV" Comment="" dx1="566.6666666666667"/>
				<Connection Source="Controller.MV" Destination="Process.U" Comment="" dx1="80.0" dx2="80.0" dy="160.0"/>
			</DataConnections>
		</SubAppNetwork>
	</Application>
	<Device Name="LocalPID" Type="FORTE_PC" Comment="" x="3066.666666666667" y="3200.0">
		<Parameter Name="MGR_ID" Value="&quot;localhost:61499&quot;"/>
		<Attribute Name="Profile" Type="STRING" Value="HOLOBLOC" Comment="device profile"/>
		<Attribute Name="Color" Type="STRING" Value="255,190,111" Comment="color"/>
		<Resource Name="EMB_RES" Type="EMB_RES" Comment="" x="0.0" y="0.0">
			<FBNetwork>
				<FB Name="Controller" Type="PID_FLAG" Comment="" x="4400.0" y="300.0">
					<Parameter Name="KP" Value="1.0"/>
					<Parameter Name="KI" Value="0.5"/>
					<Parameter Name="KD" Value="0.1"/>
					<Parameter Name="TS_S" Value="0.1"/>
					<Parameter Name="U_MIN" Value="0.0"/>
					<Parameter Name="U_MAX" Value="10.0"/>
					<Parameter Name="SP" Value="1.0"/>
				</FB>
				<FB Name="Process" Type="PID_DEMO_PROCESS" Comment="" x="2200.0" y="300.0">
				</FB>
				<FB Name="Cycle" Type="E_CYCLE" Comment="" x="300.0" y="300.0">
					<Parameter Name="DT" Value="T#100ms"/>
				</FB>
				<EventConnections>
					<Connection Source="Controller.CNF" Destination="Process.APPLY" Comment="" dx1="80.0" dx2="80.0" dy="46.66666666666667"/>
					<Connection Source="Process.INITO" Destination="Controller.INIT" Comment=""/>
					<Connection Source="Process.CNF" Destination="Controller.REQ" Comment=""/>
					<Connection Source="Controller.INITO" Destination="Cycle.START" Comment="" dx1="80.0" dx2="80.0" dy="160.0"/>
					<Connection Source="Process.ERR" Destination="Cycle.STOP" Comment="" dx1="80.0" dx2="80.0" dy="-100.0"/>
					<Connection Source="Controller.ERR" Destination="Cycle.STOP" Comment="" dx1="80.0" dx2="80.0" dy="-100.0"/>
					<Connection Source="Cycle.EO" Destination="Process.REQ" Comment="" dx1="626.6666666666667"/>
				</EventConnections>
				<DataConnections>
					<Connection Source="Controller.MV" Destination="Process.U" Comment="" dx1="80.0" dx2="80.0" dy="160.0"/>
					<Connection Source="Process.Y" Destination="Controller.PV" Comment="" dx1="566.6666666666667"/>
				</DataConnections>
			</FBNetwork>
		</Resource>
	</Device>
	<Mapping From="PID_Simulation.Controller" To="LocalPID.EMB_RES.Controller"/>
	<Mapping From="PID_Simulation.Process" To="LocalPID.EMB_RES.Process"/>
	<Mapping From="PID_Simulation.Cycle" To="LocalPID.EMB_RES.Cycle"/>
</System>
