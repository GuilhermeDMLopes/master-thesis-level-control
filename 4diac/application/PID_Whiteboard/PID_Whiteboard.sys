<?xml version='1.0' encoding='utf-8'?>
<System Name="PID_Whiteboard" Comment="Synthetic closed-loop example only; unmapped; native validation pending">
  <Application Name="PID_Simulation">
    <SubAppNetwork>
      <FB Name="Cycle" Type="E_CYCLE" x="300" y="300">
        <Parameter Name="DT" Value="T#100ms" />
      </FB>
      <FB Name="Process" Type="PID_DEMO_PROCESS" x="2200" y="300" />
      <FB Name="Controller" Type="PID_FLAG" x="4400" y="300">
        <Parameter Name="SP" Value="1.0" />
        <Parameter Name="KP" Value="1.0" />
        <Parameter Name="KI" Value="0.5" />
        <Parameter Name="KD" Value="0.1" />
        <Parameter Name="TS_S" Value="0.1" />
        <Parameter Name="U_MIN" Value="0.0" />
        <Parameter Name="U_MAX" Value="10.0" />
      </FB>
      <EventConnections>
        <Connection Source="Process.INITO" Destination="Controller.INIT" />
        <Connection Source="Controller.INITO" Destination="Cycle.START" />
        <Connection Source="Cycle.EO" Destination="Process.REQ" />
        <Connection Source="Process.CNF" Destination="Controller.REQ" />
        <Connection Source="Controller.CNF" Destination="Process.APPLY" />
        <Connection Source="Process.ERR" Destination="Cycle.STOP" />
        <Connection Source="Controller.ERR" Destination="Cycle.STOP" />
      </EventConnections>
      <DataConnections>
        <Connection Source="Process.Y" Destination="Controller.PV" />
        <Connection Source="Controller.MV" Destination="Process.U" />
      </DataConnections>
    </SubAppNetwork>
  </Application>
</System>