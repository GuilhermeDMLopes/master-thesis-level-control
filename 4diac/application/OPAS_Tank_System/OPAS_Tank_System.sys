				<Parameter Name="DAC_MIN" Value="LREAL#0.0"/>
				<Parameter Name="DAC_MAX" Value="LREAL#12000.0"/>
				<Parameter Name="INITIAL_DAC" Value="LREAL#0.0"/>
				<Parameter Name="RESET" Value="FALSE"/>
			</FB>
