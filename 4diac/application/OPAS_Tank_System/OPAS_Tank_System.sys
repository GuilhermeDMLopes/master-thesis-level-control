				<Connection Source="MpcLevelRead.INITO" Destination="MpcCycle.START" Comment=""/>
			</EventConnections>
			<DataConnections>
				<Connection Source="MpcLevelRead.RD_1" Destination="MpcMedian9.PV_RAW" Comment=""/>
				<Connection Source="MpcLevelRead.RD_1" Destination="MpcController.PV_RAW" Comment=""/>
				<Connection Source="MpcMedian9.PV_MEDIAN" Destination="MpcController.PV_MODEL" Comment=""/>
				<Connection Source="MpcAppliedDACRead.RD_1" Destination="MpcAppliedDACType.IN" Comment=""/>
				<Connection Source="MpcAppliedDACType.OUT" Destination="MpcController.APPLIED_DAC" Comment=""/>
				<Connection Source="MpcWatchdogRead.RD_1" Destination="MpcController.EXTERNAL_HEALTHY" Comment=""/>
				<Connection Source="MpcController.COMMAND_DAC" Destination="MpcSafeDACLimiter.DAC_IN" Comment=""/>
				<Connection Source="MpcSafeDACLimiter.DAC_OUT" Destination="MpcDACType.IN" Comment=""/>
				<Connection Source="MpcDACType.OUT" Destination="MpcDACWrite.SD_1" Comment=""/>
				<Connection Source="MpcController.COMMAND_ENABLE" Destination="MpcEnableWrite.SD_1" Comment=""/>
			</DataConnections>
		</SubAppNetwork>
	</Application>
