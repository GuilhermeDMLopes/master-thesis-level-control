			<FB Name="MpcDACWrite" Type="CLIENT_1_0" Comment="Write DAC command to the local gateway" x="8000.0" y="1200.0">
				<Parameter Name="QI" Value="TRUE"/>
				<Parameter Name="ID" Value="&quot;opc_ua[WRITE;opc.tcp://127.0.0.1:4841#;,2:s=DAC]&quot;"/>
			</FB>
			<FB Name="MpcEnableWrite" Type="CLIENT_1_0" Comment="Write fail-closed Enable command to the local gateway" x="8000.0" y="2600.0">
				<Parameter Name="QI" Value="TRUE"/>
				<Parameter Name="ID" Value="&quot;opc_ua[WRITE;opc.tcp://127.0.0.1:4841#;,2:s=Enable]&quot;"/>
			</FB>
			<FB Name="MpcCycle" Type="E_CYCLE" Comment="Deterministic 100 ms MPC execution clock" x="1600.0" y="5200.0">
				<Parameter Name="DT" Value="T#100ms"/>
			</FB>
			<FB Name="MpcInitMerge" Type="E_MERGE" Comment="Manual-only initialization entry point; no START.COLD/WARM connection" x="400.0" y="5200.0">
			</FB>
