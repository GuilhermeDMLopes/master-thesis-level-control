	<Application Name="MPC_REAL_RAW_SAFE_V1" Comment="Additive real-plant raw-count MPC V1. Disabled by default; historical PI and MPC artifacts remain unchanged.">
		<SubAppNetwork>
			<FB Name="MpcLevelRead" Type="SUBSCRIBE_1" Comment="Read unfiltered raw level from the local gateway" x="800.0" y="800.0">
				<Parameter Name="QI" Value="TRUE"/>
