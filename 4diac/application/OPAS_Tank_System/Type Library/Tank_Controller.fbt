	</Identification>
	<VersionInfo Version="1.0" Author="guilh" Date="2025-12-25">
	</VersionInfo>
	<InterfaceList>
		<EventInputs>
			<Event Name="REQ" Type="Event" Comment="">
				<With Var="Level"/>
			</Event>
		</EventInputs>
		<EventOutputs>
			<Event Name="CNF" Type="Event" Comment="">
				<With Var="ValveCmd"/>
			</Event>
		</EventOutputs>
		<InputVars>
			<VarDeclaration Name="Level" Type="REAL" Comment=""/>
		</InputVars>
		<OutputVars>
			<VarDeclaration Name="ValveCmd" Type="REAL" Comment=""/>
		</OutputVars>
	</InterfaceList>
	<BasicFB>
		<ECC>
