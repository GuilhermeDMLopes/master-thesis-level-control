<?xml version='1.0' encoding='utf-8'?>
<FBType Name="MPC_MOVE_BLOCKED_NMPC_V3H" Comment="Additive V3H state-disturbance MPC preserving V3E envelope, delay-aware model and exporter-safe nested candidate/prediction loops">
  <Identification Standard="61499-2">
	</Identification>
  <VersionInfo Version="3.8" Author="Guilherme" Date="2026-08-22">
	</VersionInfo>
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event" Comment="Execute one 500 ms delay-aware MPC V3 cycle">
        <With Var="PV_RAW" />
        <With Var="PV_MODEL" />
        <With Var="APPLIED_DAC" />
        <With Var="ENABLE_REQUEST" />
        <With Var="EXTERNAL_HEALTHY" />
        <With Var="RESET_REQUEST" />
        <With Var="SP_RAW" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event" Comment="MPC cycle completed">
        <With Var="COMMAND_ENABLE" />
        <With Var="COMMAND_DAC" />
        <With Var="TRIPPED" />
        <With Var="TRIP_CODE" />
        <With Var="SELECTED_TARGET_DAC" />
        <With Var="INPUT_BIAS_ESTIMATE_DAC" />
        <With Var="PREDICTED_MAX_RAW" />
        <With Var="PREDICTED_FINAL_RAW" />
        <With Var="CONFIGURATION_VALID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="PV_RAW" Type="LREAL" Comment="Unfiltered raw level used by the measured hard trip" />
      <VarDeclaration Name="PV_MODEL" Type="LREAL" Comment="9-sample rolling-median raw level used by the identified model" />
      <VarDeclaration Name="APPLIED_DAC" Type="LREAL" Comment="PLC-confirmed DAC used as the move-constraint reference" />
      <VarDeclaration Name="ENABLE_REQUEST" Type="BOOL" Comment="Explicit operator/commissioning enable; FALSE is normal zero-output mode" />
      <VarDeclaration Name="EXTERNAL_HEALTHY" Type="BOOL" Comment="PLC/gateway watchdog healthy input" />
      <VarDeclaration Name="RESET_REQUEST" Type="BOOL" Comment="Explicitly clear the latched MPC trip and internal estimator state" />
      <VarDeclaration Name="SP_RAW" Type="LREAL" Comment="Raw-count setpoint; first commissioning value is 450" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="COMMAND_ENABLE" Type="BOOL" Comment="Fail-closed actuator enable request" />
      <VarDeclaration Name="COMMAND_DAC" Type="LREAL" Comment="MPC DAC request before downstream defense-in-depth limiting" />
      <VarDeclaration Name="TRIPPED" Type="BOOL" Comment="Latched MPC trip state" />
      <VarDeclaration Name="TRIP_CODE" Type="INT" Comment="0=none,1=health,2=PV invalid,3=measured high,4=AppliedDAC,5=setpoint,6=no feasible prediction" />
      <VarDeclaration Name="SELECTED_TARGET_DAC" Type="LREAL" Comment="Move-blocked target selected by the current horizon search" />
      <VarDeclaration Name="INPUT_BIAS_ESTIMATE_DAC" Type="LREAL" Comment="Bounded offset-compensation estimate" />
      <VarDeclaration Name="PREDICTED_MAX_RAW" Type="LREAL" Comment="Maximum predicted model level for the selected candidate" />
      <VarDeclaration Name="PREDICTED_FINAL_RAW" Type="LREAL" Comment="Final horizon model level for the selected candidate" />
      <VarDeclaration Name="CONFIGURATION_VALID" Type="BOOL" Comment="Frozen V1 commissioning configuration is internally valid" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="trip_latched_internal" Type="BOOL" InitialValue="FALSE" />
      <VarDeclaration Name="trip_code_internal" Type="INT" InitialValue="0" />
      <VarDeclaration Name="history_count" Type="DINT" InitialValue="0" />
      <VarDeclaration Name="record_history_internal" Type="BOOL" InitialValue="FALSE" />
      <VarDeclaration Name="best_found" Type="BOOL" InitialValue="FALSE" />
      <VarDeclaration Name="candidate_feasible" Type="BOOL" InitialValue="FALSE" />
      <VarDeclaration Name="h00" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h01" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h02" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h03" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h04" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h05" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h06" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h07" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h08" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h09" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h10" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h11" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h12" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h13" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h14" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h15" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h16" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="h17" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q00" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q01" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q02" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q03" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q04" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q05" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q06" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q07" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q08" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q09" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q10" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q11" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q12" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q13" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q14" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q15" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q16" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="q17" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="best_cost" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="best_target" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="best_predicted_max" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="best_predicted_final" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="candidate_target" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="predicted_y" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="predicted_u" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="previous_u" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="delayed_u" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="candidate_cost" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="candidate_predicted_max" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="delta_u" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="effective_input" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="phi_value" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="tracking_error" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="move_value" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="soft_excess" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="terminal_error" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="command_candidate" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="candidate_index" Type="DINT" InitialValue="0" />
      <VarDeclaration Name="prediction_index" Type="DINT" InitialValue="0" />
      <VarDeclaration Name="disturbance_hat_internal" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="disturbance_previous_pv_internal" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="disturbance_previous_valid_internal" Type="BOOL" InitialValue="FALSE" />
      <VarDeclaration Name="disturbance_prediction_internal" Type="LREAL" InitialValue="0.0" />
      <VarDeclaration Name="disturbance_innovation_internal" Type="LREAL" InitialValue="0.0" />
    </InternalVars>
    <ECC>
      <ECState Name="START" x="120.0" y="120.0">
			</ECState>
      <ECState Name="EXEC" x="520.0" y="120.0">
        <ECAction Algorithm="ALG_NMPC" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="EXEC" Condition="REQ" x="300.0" y="100.0" />
      <ECTransition Source="EXEC" Destination="START" Condition="1" x="300.0" y="220.0" />
    </ECC>
    <Algorithm Name="ALG_NMPC" Comment="Frozen move-blocked NMPC V1 with model constraints, trip latch, offset compensation, and piecewise-linear x^1.2 model input">
      <ST>IF RESET_REQUEST THEN
    trip_latched_internal := FALSE;
    trip_code_internal := 0;
    disturbance_hat_internal := LREAL#0.0;
    disturbance_previous_pv_internal := LREAL#0.0;
    disturbance_previous_valid_internal := FALSE;
    disturbance_prediction_internal := LREAL#0.0;
    disturbance_innovation_internal := LREAL#0.0;
END_IF;

CONFIGURATION_VALID := TRUE;
COMMAND_ENABLE := FALSE;
COMMAND_DAC := LREAL#0.0;
SELECTED_TARGET_DAC := LREAL#0.0;
INPUT_BIAS_ESTIMATE_DAC := LREAL#0.0;
PREDICTED_MAX_RAW := LREAL#-1.0;
PREDICTED_FINAL_RAW := LREAL#-1.0;

record_history_internal := (PV_RAW = PV_RAW) AND (PV_MODEL = PV_MODEL) AND (APPLIED_DAC = APPLIED_DAC) AND (SP_RAW = SP_RAW) AND (APPLIED_DAC &gt;= LREAL#0.0) AND (APPLIED_DAC &lt;= LREAL#12000.0);

IF NOT trip_latched_internal THEN
    IF NOT ENABLE_REQUEST THEN
        disturbance_hat_internal := LREAL#0.0;
        disturbance_previous_pv_internal := LREAL#0.0;
        disturbance_previous_valid_internal := FALSE;
        disturbance_prediction_internal := LREAL#0.0;
        disturbance_innovation_internal := LREAL#0.0;
        COMMAND_ENABLE := FALSE;
        COMMAND_DAC := LREAL#0.0;
    ELSE
        IF NOT EXTERNAL_HEALTHY THEN
            trip_latched_internal := TRUE;
            trip_code_internal := 2;
        ELSIF NOT (PV_RAW = PV_RAW) OR NOT (PV_MODEL = PV_MODEL) OR NOT (APPLIED_DAC = APPLIED_DAC) OR NOT (SP_RAW = SP_RAW) THEN
            trip_latched_internal := TRUE;
            trip_code_internal := 1;
        ELSIF PV_RAW &lt; LREAL#0.0 OR PV_MODEL &lt; LREAL#0.0 OR PV_RAW &gt;= LREAL#1500.0 THEN
            trip_latched_internal := TRUE;
            trip_code_internal := 3;
        ELSIF APPLIED_DAC &lt; LREAL#0.0 OR APPLIED_DAC &gt; LREAL#12000.0 THEN
            trip_latched_internal := TRUE;
            trip_code_internal := 4;
        ELSIF SP_RAW &lt; LREAL#0.0 OR SP_RAW &gt;= LREAL#800.0 THEN
            trip_latched_internal := TRUE;
            trip_code_internal := 5;
        ELSIF history_count &lt; 18 THEN
            trip_latched_internal := TRUE;
            trip_code_internal := 7;
        ELSE
            IF disturbance_previous_valid_internal THEN
                IF disturbance_previous_pv_internal &lt; LREAL#288.0 THEN
                    disturbance_previous_pv_internal := LREAL#288.0;
                END_IF;
                effective_input := h00 - LREAL#11750.0;
                IF effective_input &lt; LREAL#0.0 THEN
                    effective_input := LREAL#0.0;
                ELSIF effective_input &gt; LREAL#500.0 THEN
                    effective_input := LREAL#500.0;
                END_IF;
                IF effective_input &lt;= LREAL#0.0 THEN
                    phi_value := LREAL#0.0;
                ELSIF effective_input &lt;= LREAL#50.0 THEN
                    phi_value := LREAL#0.0 + LREAL#2.186724147886556 * (effective_input - LREAL#0.0);
                ELSIF effective_input &lt;= LREAL#100.0 THEN
                    phi_value := LREAL#109.336207394327786 + LREAL#2.837048715132604 * (effective_input - LREAL#50.0);
                ELSIF effective_input &lt;= LREAL#150.0 THEN
                    phi_value := LREAL#251.188643150957972 + LREAL#3.148436919260821 * (effective_input - LREAL#100.0);
                ELSIF effective_input &lt;= LREAL#200.0 THEN
                    phi_value := LREAL#408.610489113999051 + LREAL#3.369389464977726 * (effective_input - LREAL#150.0);
                ELSIF effective_input &lt;= LREAL#250.0 THEN
                    phi_value := LREAL#577.07996236288534 + LREAL#3.543841594105197 * (effective_input - LREAL#200.0);
                ELSIF effective_input &lt;= LREAL#300.0 THEN
                    phi_value := LREAL#754.272042068145197 + LREAL#3.689367025828481 * (effective_input - LREAL#250.0);
                ELSIF effective_input &lt;= LREAL#350.0 THEN
                    phi_value := LREAL#938.740393359569225 + LREAL#3.814953797640478 * (effective_input - LREAL#300.0);
                ELSIF effective_input &lt;= LREAL#400.0 THEN
                    phi_value := LREAL#1129.488083241593131 + LREAL#3.925870473888026 * (effective_input - LREAL#350.0);
                ELSIF effective_input &lt;= LREAL#450.0 THEN
                    phi_value := LREAL#1325.781606935994432 + LREAL#4.025491573724398 * (effective_input - LREAL#400.0);
                ELSIF effective_input &lt;= LREAL#500.0 THEN
                    phi_value := LREAL#1527.056185622214343 + LREAL#4.116118445313023 * (effective_input - LREAL#450.0);
                ELSE
                    phi_value := LREAL#1732.862107887865477;
                END_IF;
                disturbance_prediction_internal := LREAL#288.0 + LREAL#0.900087626252259 * (disturbance_previous_pv_internal - LREAL#288.0) + LREAL#0.067989118863552 * phi_value;
                disturbance_innovation_internal := PV_MODEL - disturbance_prediction_internal;
                disturbance_hat_internal := LREAL#0.9 * disturbance_hat_internal + LREAL#0.1 * disturbance_innovation_internal;
                IF disturbance_hat_internal &gt; LREAL#100.0 THEN
                    disturbance_hat_internal := LREAL#100.0;
                ELSIF disturbance_hat_internal &lt; LREAL#-100.0 THEN
                    disturbance_hat_internal := LREAL#-100.0;
                END_IF;
            END_IF;
            disturbance_previous_pv_internal := PV_MODEL;
            disturbance_previous_valid_internal := TRUE;
            best_found := FALSE;
            best_cost := LREAL#1000000000.0;
            best_target := LREAL#0.0;
            best_predicted_max := LREAL#-1.0;
            best_predicted_final := LREAL#-1.0;
            FOR candidate_index := 0 TO 12 DO
                CASE candidate_index OF
                    0:
                        candidate_target := LREAL#0.0;
                    1:
                        candidate_target := LREAL#11500.0;
                    2:
                        candidate_target := LREAL#11550.0;
                    3:
                        candidate_target := LREAL#11600.0;
                    4:
                        candidate_target := LREAL#11650.0;
                    5:
                        candidate_target := LREAL#11700.0;
                    6:
                        candidate_target := LREAL#11750.0;
                    7:
                        candidate_target := LREAL#11800.0;
                    8:
                        candidate_target := LREAL#11845.626677302696407;
                    9:
                        candidate_target := LREAL#11850.0;
                    10:
                        candidate_target := LREAL#11900.0;
                    11:
                        candidate_target := LREAL#11950.0;
                    12:
                        candidate_target := LREAL#12000.0;
                    ELSE
                        candidate_target := LREAL#0.0;
                END_CASE;
                q00 := h00;
                q01 := h01;
                q02 := h02;
                q03 := h03;
                q04 := h04;
                q05 := h05;
                q06 := h06;
                q07 := h07;
                q08 := h08;
                q09 := h09;
                q10 := h10;
                q11 := h11;
                q12 := h12;
                q13 := h13;
                q14 := h14;
                q15 := h15;
                q16 := h16;
                q17 := h17;
                IF PV_MODEL &lt; LREAL#288.0 THEN
                    predicted_y := LREAL#288.0;
                ELSE
                    predicted_y := PV_MODEL;
                END_IF;
                predicted_u := APPLIED_DAC;
                previous_u := APPLIED_DAC;
                candidate_cost := LREAL#0.0;
                candidate_predicted_max := predicted_y;
                candidate_feasible := TRUE;
                FOR prediction_index := 1 TO 60 DO
                    IF candidate_feasible THEN
                        delta_u := candidate_target - predicted_u;
                        IF delta_u &gt; LREAL#750.0 THEN
                            delta_u := LREAL#750.0;
                        ELSIF delta_u &lt; LREAL#-750.0 THEN
                            delta_u := LREAL#-750.0;
                        END_IF;
                        predicted_u := predicted_u + delta_u;
                        IF predicted_u &gt; LREAL#12000.0 THEN
                            predicted_u := LREAL#12000.0;
                        ELSIF predicted_u &lt; LREAL#0.0 THEN
                            predicted_u := LREAL#0.0;
                        END_IF;
                        delayed_u := q00;
                        q00 := q01;
                        q01 := q02;
                        q02 := q03;
                        q03 := q04;
                        q04 := q05;
                        q05 := q06;
                        q06 := q07;
                        q07 := q08;
                        q08 := q09;
                        q09 := q10;
                        q10 := q11;
                        q11 := q12;
                        q12 := q13;
                        q13 := q14;
                        q14 := q15;
                        q15 := q16;
                        q16 := q17;
                        q17 := predicted_u;
                        effective_input := delayed_u - LREAL#11750.0;
                        IF effective_input &lt; LREAL#0.0 THEN
                            effective_input := LREAL#0.0;
                        ELSIF effective_input &gt; LREAL#500.0 THEN
                            effective_input := LREAL#500.0;
                        END_IF;
                        IF effective_input &lt;= LREAL#0.0 THEN
                            phi_value := LREAL#0.0;
                        ELSIF effective_input &lt;= LREAL#50.0 THEN
                            phi_value := LREAL#0.0 + LREAL#2.186724147886556 * (effective_input - LREAL#0.0);
                        ELSIF effective_input &lt;= LREAL#100.0 THEN
                            phi_value := LREAL#109.336207394327786 + LREAL#2.837048715132604 * (effective_input - LREAL#50.0);
                        ELSIF effective_input &lt;= LREAL#150.0 THEN
                            phi_value := LREAL#251.188643150957972 + LREAL#3.148436919260821 * (effective_input - LREAL#100.0);
                        ELSIF effective_input &lt;= LREAL#200.0 THEN
                            phi_value := LREAL#408.610489113999051 + LREAL#3.369389464977726 * (effective_input - LREAL#150.0);
                        ELSIF effective_input &lt;= LREAL#250.0 THEN
                            phi_value := LREAL#577.07996236288534 + LREAL#3.543841594105197 * (effective_input - LREAL#200.0);
                        ELSIF effective_input &lt;= LREAL#300.0 THEN
                            phi_value := LREAL#754.272042068145197 + LREAL#3.689367025828481 * (effective_input - LREAL#250.0);
                        ELSIF effective_input &lt;= LREAL#350.0 THEN
                            phi_value := LREAL#938.740393359569225 + LREAL#3.814953797640478 * (effective_input - LREAL#300.0);
                        ELSIF effective_input &lt;= LREAL#400.0 THEN
                            phi_value := LREAL#1129.488083241593131 + LREAL#3.925870473888026 * (effective_input - LREAL#350.0);
                        ELSIF effective_input &lt;= LREAL#450.0 THEN
                            phi_value := LREAL#1325.781606935994432 + LREAL#4.025491573724398 * (effective_input - LREAL#400.0);
                        ELSIF effective_input &lt;= LREAL#500.0 THEN
                            phi_value := LREAL#1527.056185622214343 + LREAL#4.116118445313023 * (effective_input - LREAL#450.0);
                        ELSE
                            phi_value := LREAL#1732.862107887865477;
                        END_IF;
                        predicted_y := LREAL#288.0 + LREAL#0.900087626252259 * (predicted_y - LREAL#288.0) + LREAL#0.067989118863552 * phi_value + disturbance_hat_internal;
                        IF predicted_y &gt; candidate_predicted_max THEN
                            candidate_predicted_max := predicted_y;
                        END_IF;
                        IF NOT (predicted_y = predicted_y) OR predicted_y &gt; LREAL#1400.0 THEN
                            candidate_feasible := FALSE;
                        ELSE
                            tracking_error := predicted_y - SP_RAW;
                            move_value := predicted_u - previous_u;
                            candidate_cost := candidate_cost + LREAL#5.0 * tracking_error * tracking_error + LREAL#0.00004 * move_value * move_value;
                            IF predicted_y &gt; LREAL#1100.0 THEN
                                soft_excess := predicted_y - LREAL#650.0;
                                candidate_cost := candidate_cost + LREAL#100.0 * soft_excess * soft_excess;
                            END_IF;
                            previous_u := predicted_u;
                        END_IF;
                    END_IF;
                END_FOR;
                IF candidate_feasible THEN
                    terminal_error := predicted_y - SP_RAW;
                    candidate_cost := candidate_cost + LREAL#10.0 * terminal_error * terminal_error;
                    IF (NOT best_found) OR candidate_cost &lt; best_cost THEN
                        best_found := TRUE;
                        best_cost := candidate_cost;
                        best_target := candidate_target;
                        best_predicted_max := candidate_predicted_max;
                        best_predicted_final := predicted_y;
                    END_IF;
                END_IF;
            END_FOR;
            IF NOT best_found THEN
                trip_latched_internal := TRUE;
                trip_code_internal := 6;
            ELSE
                delta_u := best_target - APPLIED_DAC;
                IF delta_u &gt; LREAL#750.0 THEN
                    delta_u := LREAL#750.0;
                ELSIF delta_u &lt; LREAL#-750.0 THEN
                    delta_u := LREAL#-750.0;
                END_IF;
                command_candidate := APPLIED_DAC + delta_u;
                IF command_candidate &gt; LREAL#12000.0 THEN
                    command_candidate := LREAL#12000.0;
                ELSIF command_candidate &lt; LREAL#0.0 THEN
                    command_candidate := LREAL#0.0;
                END_IF;
                COMMAND_ENABLE := TRUE;
                COMMAND_DAC := command_candidate;
                SELECTED_TARGET_DAC := best_target;
                PREDICTED_MAX_RAW := best_predicted_max;
                PREDICTED_FINAL_RAW := best_predicted_final;
            END_IF;
        END_IF;
    END_IF;
END_IF;

IF record_history_internal THEN
    h00 := h01;
    h01 := h02;
    h02 := h03;
    h03 := h04;
    h04 := h05;
    h05 := h06;
    h06 := h07;
    h07 := h08;
    h08 := h09;
    h09 := h10;
    h10 := h11;
    h11 := h12;
    h12 := h13;
    h13 := h14;
    h14 := h15;
    h15 := h16;
    h16 := h17;
    h17 := APPLIED_DAC;
    IF history_count &lt; 18 THEN
        history_count := history_count + 1;
    END_IF;
END_IF;

TRIPPED := trip_latched_internal;
TRIP_CODE := trip_code_internal;
INPUT_BIAS_ESTIMATE_DAC := LREAL#0.0;

IF trip_latched_internal THEN
    COMMAND_ENABLE := FALSE;
    COMMAND_DAC := LREAL#0.0;
    SELECTED_TARGET_DAC := LREAL#0.0;
    PREDICTED_MAX_RAW := LREAL#-1.0;
    PREDICTED_FINAL_RAW := LREAL#-1.0;
END_IF;
</ST>
    </Algorithm>
  </BasicFB>
</FBType>