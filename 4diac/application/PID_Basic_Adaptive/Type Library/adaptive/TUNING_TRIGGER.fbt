<?xml version='1.0' encoding='utf-8'?>
<FBType Name="TUNING_TRIGGER" Comment="Select normal control or periodic model tuning; zero interval selects one update">
  <Identification Standard="61499-2" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="Event">
        <With Var="ENABLE_UPDATE" />
        <With Var="UPDATE_AT_SAMPLE" />
        <With Var="UPDATE_INTERVAL_SAMPLES" />
      </Event>
      <Event Name="REQ" Type="Event">
        <With Var="SAMPLE_NUMBER" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="Event" />
      <Event Name="CONTROL_READY" Type="Event" />
      <Event Name="TUNE" Type="Event">
        <With Var="UPDATE_ATTEMPTED" />
      </Event>
      <Event Name="ERR" Type="Event" />
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="ENABLE_UPDATE" Type="BOOL" />
      <VarDeclaration Name="UPDATE_AT_SAMPLE" Type="UINT" />
      <VarDeclaration Name="UPDATE_INTERVAL_SAMPLES" Type="UINT" />
      <VarDeclaration Name="SAMPLE_NUMBER" Type="UINT" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="UPDATE_ATTEMPTED" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="ENABLED" Type="BOOL" />
      <VarDeclaration Name="TARGET_SAMPLE" Type="UINT" />
      <VarDeclaration Name="INTERVAL_SAMPLES" Type="UINT" />
      <VarDeclaration Name="LAST_UPDATE_SAMPLE" Type="UINT" />
      <VarDeclaration Name="DUE" Type="BOOL" />
      <VarDeclaration Name="VALID" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" x="300" y="300" />
      <ECState Name="INITIALIZE" x="2300" y="300">
        <ECAction Algorithm="INITIALIZE" />
      </ECState>
      <ECState Name="INITIALIZED" x="4300" y="300">
        <ECAction Output="INITO" />
      </ECState>
      <ECState Name="READY" x="6300" y="300" />
      <ECState Name="SELECT" x="300" y="2300">
        <ECAction Algorithm="SELECT" />
      </ECState>
      <ECState Name="TUNE" x="2300" y="2300">
        <ECAction Algorithm="MARK" Output="TUNE" />
      </ECState>
      <ECState Name="PASS" x="4300" y="2300">
        <ECAction Output="CONTROL_READY" />
      </ECState>
      <ECState Name="FAILED" x="6300" y="2300">
        <ECAction Output="ERR" />
      </ECState>
      <ECTransition Source="START" Destination="INITIALIZE" Condition="INIT" x="500" y="500" />
      <ECTransition Source="READY" Destination="INITIALIZE" Condition="INIT" x="500" y="500" />
      <ECTransition Source="FAILED" Destination="INITIALIZE" Condition="INIT" x="500" y="500" />
      <ECTransition Source="START" Destination="FAILED" Condition="REQ" x="500" y="500" />
      <ECTransition Source="INITIALIZE" Destination="INITIALIZED" Condition="VALID" x="500" y="500" />
      <ECTransition Source="INITIALIZE" Destination="FAILED" Condition="NOT VALID" x="500" y="500" />
      <ECTransition Source="INITIALIZED" Destination="READY" Condition="1" x="500" y="500" />
      <ECTransition Source="READY" Destination="SELECT" Condition="REQ" x="500" y="500" />
      <ECTransition Source="SELECT" Destination="TUNE" Condition="DUE" x="500" y="500" />
      <ECTransition Source="SELECT" Destination="PASS" Condition="NOT DUE" x="500" y="500" />
      <ECTransition Source="TUNE" Destination="READY" Condition="1" x="500" y="500" />
      <ECTransition Source="PASS" Destination="READY" Condition="1" x="500" y="500" />
    </ECC>
    <Algorithm Name="INITIALIZE">
      <ST Text="ENABLED := ENABLE_UPDATE;&#10;TARGET_SAMPLE := UPDATE_AT_SAMPLE;&#10;INTERVAL_SAMPLES := UPDATE_INTERVAL_SAMPLES;&#10;LAST_UPDATE_SAMPLE := 0;&#10;UPDATE_ATTEMPTED := FALSE;&#10;VALID := (NOT ENABLED) OR (TARGET_SAMPLE &gt; 0);" />
    </Algorithm>
    <Algorithm Name="SELECT">
      <ST Text="DUE := ENABLED AND (NOT UPDATE_ATTEMPTED) AND (SAMPLE_NUMBER = TARGET_SAMPLE);&#10;IF ENABLED AND UPDATE_ATTEMPTED AND (INTERVAL_SAMPLES &gt; 0) AND (SAMPLE_NUMBER &gt;= LAST_UPDATE_SAMPLE) THEN&#10;    DUE := (SAMPLE_NUMBER - LAST_UPDATE_SAMPLE) &gt;= INTERVAL_SAMPLES;&#10;END_IF;" />
    </Algorithm>
    <Algorithm Name="MARK">
      <ST Text="UPDATE_ATTEMPTED := TRUE;&#10;LAST_UPDATE_SAMPLE := SAMPLE_NUMBER;" />
    </Algorithm>
  </BasicFB>
</FBType>