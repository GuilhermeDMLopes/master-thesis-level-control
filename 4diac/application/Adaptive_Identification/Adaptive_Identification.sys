<?xml version='1.0' encoding='utf-8'?>
<System Name="Adaptive_Identification" Comment="Offline only; native export and runtime validation pending">
  <Application Name="Identification_Offline">
    <SubAppNetwork>
      <FB Name="SamplingClock" Type="E_CYCLE" x="300" y="300">
        <Parameter Name="DT" Value="T#100ms" />
      </FB>
      <FB Name="IdentificationTest" Type="PROCESS_IDENTIFICATION" x="2200" y="300">
        <Parameter Name="FORGETTING_FACTOR" Value="0.8" />
        <Parameter Name="ENABLE_PROCESS_CHANGE" Value="TRUE" />
        <Parameter Name="INITIAL_COVARIANCE" Value="10000.0" />
      </FB>
      <EventConnections>
        <Connection Source="IdentificationTest.INITO" Destination="SamplingClock.START" />
        <Connection Source="SamplingClock.EO" Destination="IdentificationTest.REQ" />
        <Connection Source="IdentificationTest.DONE" Destination="SamplingClock.STOP" />
        <Connection Source="IdentificationTest.ERR" Destination="SamplingClock.STOP" />
      </EventConnections>
    </SubAppNetwork>
  </Application>
</System>