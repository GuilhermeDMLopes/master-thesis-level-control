      </ECState>
      <ECState Name="READY" x="1050" y="150" />
      <ECState Name="EXECUTE" x="150" y="450">
        <ECAction Algorithm="NEXT" Output="CNF" />
      </ECState>
      <ECState Name="FINISH" x="600" y="450">
