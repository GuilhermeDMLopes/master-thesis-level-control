      <ECTransition Source="READY" Destination="INITIALIZE" Condition="INIT" />
      <ECTransition Source="READY" Destination="EXECUTE" Condition="REQ [K &lt; 100]" />
      <ECTransition Source="READY" Destination="FINISH" Condition="REQ [K &gt;= 100]" />
      <ECTransition Source="EXECUTE" Destination="READY" Condition="1" />
      <ECTransition Source="FINISH" Destination="READY" Condition="1" />
    </ECC>
