<?xml version='1.0' encoding='utf-8'?>
<FBType Name="SECOND_ORDER_PROCESS" Comment="Offline identification prototype; see docs/adaptive/4diac-design.md">
  <Identification Standard="61499-2" />
  <VersionInfo Version="0.1" Author="Guilherme" Date="2026-09-26" />
  <InterfaceList>
    <EventInputs>
      <Event Name="INIT" Type="Event" />
      <Event Name="REQ" Type="Event">
        <With Var="OUTPUT_PREVIOUS_1" />
        <With Var="OUTPUT_PREVIOUS_2" />
        <With Var="INPUT_PREVIOUS_1" />
        <With Var="INPUT_PREVIOUS_2" />
        <With Var="TRUE_INPUT_COEFFICIENT" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="INITO" Type="Event">
        <With Var="PROCESS_OUTPUT" />
      </Event>
      <Event Name="CNF" Type="Event">
        <With Var="PROCESS_OUTPUT" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="OUTPUT_PREVIOUS_1" Type="LREAL" />
      <VarDeclaration Name="OUTPUT_PREVIOUS_2" Type="LREAL" />
      <VarDeclaration Name="INPUT_PREVIOUS_1" Type="LREAL" />
      <VarDeclaration Name="INPUT_PREVIOUS_2" Type="LREAL" />
      <VarDeclaration Name="TRUE_INPUT_COEFFICIENT" Type="LREAL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="PROCESS_OUTPUT" Type="LREAL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars />
    <ECC>
      <ECState Name="START" x="150" y="150" />
      <ECState Name="INITIALIZE" x="600" y="150">
        <ECAction Algorithm="INITIALIZE" Output="INITO" />
      </ECState>
      <ECState Name="READY" x="1050" y="150" />
      <ECState Name="EXECUTE" x="150" y="450">
        <ECAction Algorithm="CALCULATE" Output="CNF" />
      </ECState>
      <ECTransition Source="START" Destination="INITIALIZE" Condition="INIT" />
      <ECTransition Source="INITIALIZE" Destination="READY" Condition="1" />
      <ECTransition Source="READY" Destination="INITIALIZE" Condition="INIT" />
      <ECTransition Source="READY" Destination="EXECUTE" Condition="REQ" />
      <ECTransition Source="EXECUTE" Destination="READY" Condition="1" />
    </ECC>
    <Algorithm Name="INITIALIZE">
      <ST Text="PROCESS_OUTPUT := 0.0;" />
    </Algorithm>
    <Algorithm Name="CALCULATE">
      <ST Text="PROCESS_OUTPUT := 1.2 * OUTPUT_PREVIOUS_1 - 0.36 * OUTPUT_PREVIOUS_2 + TRUE_INPUT_COEFFICIENT * INPUT_PREVIOUS_1 + 0.06 * INPUT_PREVIOUS_2;" />
    </Algorithm>
  </BasicFB>
</FBType>