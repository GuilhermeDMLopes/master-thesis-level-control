<?xml version='1.0' encoding='utf-8'?>
<FBType Name="PID_GAIN_TRANSITION" Comment="Experimental; offline checks only; native export/runtime pending">
  <Identification Standard="61499-2" />
  <VersionInfo Version="0.1" Author="Guilherme" Date="2026-10-20" />
  <InterfaceList>
    <EventInputs>
      <Event Name="REQ" Type="Event">
        <With Var="SETPOINT" />
        <With Var="PROCESS_VARIABLE" />
        <With Var="INTEGRAL_MEMORY" />
        <With Var="PREVIOUS_ERROR" />
        <With Var="ACTIVE_SAMPLE_TIME_S" />
        <With Var="ACTIVE_OUTPUT_MIN" />
        <With Var="ACTIVE_OUTPUT_MAX" />
        <With Var="ACTIVE_PROPORTIONAL_GAIN" />
        <With Var="ACTIVE_INTEGRAL_GAIN" />
        <With Var="ACTIVE_DERIVATIVE_GAIN" />
        <With Var="TARGET_PROPORTIONAL_GAIN" />
        <With Var="TARGET_INTEGRAL_GAIN" />
        <With Var="TARGET_DERIVATIVE_GAIN" />
        <With Var="MAX_GAIN_OUTPUT_CHANGE" />
        <With Var="MAX_RELATIVE_GAIN_STEP" />
        <With Var="PROPORTIONAL_SCALE_FLOOR" />
        <With Var="INTEGRAL_SCALE_FLOOR" />
        <With Var="DERIVATIVE_SCALE_FLOOR" />
        <With Var="MODEL_OUTPUT_COEFFICIENT_1" />
        <With Var="MODEL_OUTPUT_COEFFICIENT_2" />
        <With Var="MODEL_INPUT_COEFFICIENT_1" />
        <With Var="MODEL_INPUT_COEFFICIENT_2" />
        <With Var="INTEGRATION_ENABLED" />
        <With Var="TUNING_ALLOWED" />
      </Event>
    </EventInputs>
    <EventOutputs>
      <Event Name="CNF" Type="Event">
        <With Var="NEXT_PROPORTIONAL_GAIN" />
        <With Var="NEXT_INTEGRAL_GAIN" />
        <With Var="NEXT_DERIVATIVE_GAIN" />
        <With Var="GAIN_OUTPUT_CHANGE" />
        <With Var="STEP_FRACTION" />
        <With Var="UPDATE_APPLIED" />
        <With Var="VALID" />
      </Event>
      <Event Name="ERR" Type="Event">
        <With Var="VALID" />
      </Event>
    </EventOutputs>
    <InputVars>
      <VarDeclaration Name="SETPOINT" Type="LREAL" />
      <VarDeclaration Name="PROCESS_VARIABLE" Type="LREAL" />
      <VarDeclaration Name="INTEGRAL_MEMORY" Type="LREAL" />
      <VarDeclaration Name="PREVIOUS_ERROR" Type="LREAL" />
      <VarDeclaration Name="ACTIVE_SAMPLE_TIME_S" Type="LREAL" />
      <VarDeclaration Name="ACTIVE_OUTPUT_MIN" Type="LREAL" />
      <VarDeclaration Name="ACTIVE_OUTPUT_MAX" Type="LREAL" />
      <VarDeclaration Name="ACTIVE_PROPORTIONAL_GAIN" Type="LREAL" />
      <VarDeclaration Name="ACTIVE_INTEGRAL_GAIN" Type="LREAL" />
      <VarDeclaration Name="ACTIVE_DERIVATIVE_GAIN" Type="LREAL" />
      <VarDeclaration Name="TARGET_PROPORTIONAL_GAIN" Type="LREAL" />
      <VarDeclaration Name="TARGET_INTEGRAL_GAIN" Type="LREAL" />
      <VarDeclaration Name="TARGET_DERIVATIVE_GAIN" Type="LREAL" />
      <VarDeclaration Name="MAX_GAIN_OUTPUT_CHANGE" Type="LREAL" />
      <VarDeclaration Name="MAX_RELATIVE_GAIN_STEP" Type="LREAL" />
      <VarDeclaration Name="PROPORTIONAL_SCALE_FLOOR" Type="LREAL" />
      <VarDeclaration Name="INTEGRAL_SCALE_FLOOR" Type="LREAL" />
      <VarDeclaration Name="DERIVATIVE_SCALE_FLOOR" Type="LREAL" />
      <VarDeclaration Name="MODEL_OUTPUT_COEFFICIENT_1" Type="LREAL" />
      <VarDeclaration Name="MODEL_OUTPUT_COEFFICIENT_2" Type="LREAL" />
      <VarDeclaration Name="MODEL_INPUT_COEFFICIENT_1" Type="LREAL" />
      <VarDeclaration Name="MODEL_INPUT_COEFFICIENT_2" Type="LREAL" />
      <VarDeclaration Name="INTEGRATION_ENABLED" Type="BOOL" />
      <VarDeclaration Name="TUNING_ALLOWED" Type="BOOL" />
    </InputVars>
    <OutputVars>
      <VarDeclaration Name="NEXT_PROPORTIONAL_GAIN" Type="LREAL" />
      <VarDeclaration Name="NEXT_INTEGRAL_GAIN" Type="LREAL" />
      <VarDeclaration Name="NEXT_DERIVATIVE_GAIN" Type="LREAL" />
      <VarDeclaration Name="GAIN_OUTPUT_CHANGE" Type="LREAL" />
      <VarDeclaration Name="STEP_FRACTION" Type="LREAL" />
      <VarDeclaration Name="UPDATE_APPLIED" Type="BOOL" />
      <VarDeclaration Name="VALID" Type="BOOL" />
    </OutputVars>
  </InterfaceList>
  <BasicFB>
    <InternalVars>
      <VarDeclaration Name="CURRENT_ERROR" Type="LREAL" />
      <VarDeclaration Name="NEXT_INTEGRAL" Type="LREAL" />
      <VarDeclaration Name="CURRENT_DERIVATIVE" Type="LREAL" />
      <VarDeclaration Name="OLD_RAW" Type="LREAL" />
      <VarDeclaration Name="NEW_RAW" Type="LREAL" />
      <VarDeclaration Name="DELTA_P" Type="LREAL" />
      <VarDeclaration Name="DELTA_I" Type="LREAL" />
      <VarDeclaration Name="DELTA_D" Type="LREAL" />
      <VarDeclaration Name="FULL_EFFECT" Type="LREAL" />
      <VarDeclaration Name="MAGNITUDE" Type="LREAL" />
      <VarDeclaration Name="SCALE" Type="LREAL" />
      <VarDeclaration Name="RELATIVE_STEP" Type="LREAL" />
      <VarDeclaration Name="FRACTION_LIMIT" Type="LREAL" />
      <VarDeclaration Name="CANDIDATE_P" Type="LREAL" />
      <VarDeclaration Name="CANDIDATE_I" Type="LREAL" />
      <VarDeclaration Name="CANDIDATE_D" Type="LREAL" />
      <VarDeclaration Name="Q0" Type="LREAL" />
      <VarDeclaration Name="Q1" Type="LREAL" />
      <VarDeclaration Name="Q2" Type="LREAL" />
      <VarDeclaration Name="A1" Type="LREAL" />
      <VarDeclaration Name="A2" Type="LREAL" />
      <VarDeclaration Name="A3" Type="LREAL" />
      <VarDeclaration Name="A4" Type="LREAL" />
      <VarDeclaration Name="DENOMINATOR" Type="LREAL" />
      <VarDeclaration Name="B1" Type="LREAL" />
      <VarDeclaration Name="B2" Type="LREAL" />
      <VarDeclaration Name="B3" Type="LREAL" />
      <VarDeclaration Name="C1" Type="LREAL" />
      <VarDeclaration Name="C2" Type="LREAL" />
      <VarDeclaration Name="D1" Type="LREAL" />
      <VarDeclaration Name="CANDIDATE_VALID" Type="BOOL" />
    </InternalVars>
    <ECC>
      <ECState Name="START" x="300" y="300" />
      <ECState Name="CALCULATE" x="2200" y="300">
        <ECAction Algorithm="CALCULATE" />
      </ECState>
      <ECState Name="DONE" x="4100" y="300">
        <ECAction Output="CNF" />
      </ECState>
      <ECState Name="FAILED" x="6000" y="300">
        <ECAction Output="ERR" />
      </ECState>
      <ECTransition Source="START" Destination="CALCULATE" Condition="REQ" x="500" y="500" />
      <ECTransition Source="CALCULATE" Destination="DONE" Condition="VALID" x="500" y="500" />
      <ECTransition Source="CALCULATE" Destination="FAILED" Condition="NOT VALID" x="500" y="500" />
      <ECTransition Source="DONE" Destination="START" Condition="1" x="500" y="500" />
      <ECTransition Source="FAILED" Destination="START" Condition="1" x="500" y="500" />
    </ECC>
    <Algorithm Name="CALCULATE">
      <ST Text="VALID := (SETPOINT &gt;= -1.0E+100) AND (SETPOINT &lt;= 1.0E+100) AND (PROCESS_VARIABLE &gt;= -1.0E+100) AND (PROCESS_VARIABLE &lt;= 1.0E+100) AND (INTEGRAL_MEMORY &gt;= -1.0E+100) AND (INTEGRAL_MEMORY &lt;= 1.0E+100) AND (PREVIOUS_ERROR &gt;= -1.0E+100) AND (PREVIOUS_ERROR &lt;= 1.0E+100) AND (ACTIVE_SAMPLE_TIME_S &gt;= -1.0E+100) AND (ACTIVE_SAMPLE_TIME_S &lt;= 1.0E+100) AND (ACTIVE_OUTPUT_MIN &gt;= -1.0E+100) AND (ACTIVE_OUTPUT_MIN &lt;= 1.0E+100) AND (ACTIVE_OUTPUT_MAX &gt;= -1.0E+100) AND (ACTIVE_OUTPUT_MAX &lt;= 1.0E+100) AND (ACTIVE_PROPORTIONAL_GAIN &gt;= -1.0E+100) AND (ACTIVE_PROPORTIONAL_GAIN &lt;= 1.0E+100) AND (ACTIVE_INTEGRAL_GAIN &gt;= -1.0E+100) AND (ACTIVE_INTEGRAL_GAIN &lt;= 1.0E+100) AND (ACTIVE_DERIVATIVE_GAIN &gt;= -1.0E+100) AND (ACTIVE_DERIVATIVE_GAIN &lt;= 1.0E+100) AND (MAX_GAIN_OUTPUT_CHANGE &gt;= -1.0E+100) AND (MAX_GAIN_OUTPUT_CHANGE &lt;= 1.0E+100) AND (MAX_RELATIVE_GAIN_STEP &gt;= -1.0E+100) AND (MAX_RELATIVE_GAIN_STEP &lt;= 1.0E+100) AND (PROPORTIONAL_SCALE_FLOOR &gt;= -1.0E+100) AND (PROPORTIONAL_SCALE_FLOOR &lt;= 1.0E+100) AND (INTEGRAL_SCALE_FLOOR &gt;= -1.0E+100) AND (INTEGRAL_SCALE_FLOOR &lt;= 1.0E+100) AND (DERIVATIVE_SCALE_FLOOR &gt;= -1.0E+100) AND (DERIVATIVE_SCALE_FLOOR &lt;= 1.0E+100) AND (ACTIVE_SAMPLE_TIME_S &gt; 0.0) AND (ACTIVE_OUTPUT_MIN &lt; ACTIVE_OUTPUT_MAX) AND (MAX_GAIN_OUTPUT_CHANGE &gt; 0.0) AND (MAX_RELATIVE_GAIN_STEP &gt; 0.0) AND (MAX_RELATIVE_GAIN_STEP &lt;= 1.0) AND (PROPORTIONAL_SCALE_FLOOR &gt; 0.0) AND (INTEGRAL_SCALE_FLOOR &gt; 0.0) AND (DERIVATIVE_SCALE_FLOOR &gt; 0.0);&#10;UPDATE_APPLIED := FALSE;&#10;GAIN_OUTPUT_CHANGE := 0.0;&#10;STEP_FRACTION := 0.0;&#10;IF VALID THEN&#10;NEXT_PROPORTIONAL_GAIN := ACTIVE_PROPORTIONAL_GAIN;&#10;NEXT_INTEGRAL_GAIN := ACTIVE_INTEGRAL_GAIN;&#10;NEXT_DERIVATIVE_GAIN := ACTIVE_DERIVATIVE_GAIN;&#10;IF TUNING_ALLOWED AND INTEGRATION_ENABLED THEN&#10;CANDIDATE_VALID := (TARGET_PROPORTIONAL_GAIN &gt;= -1.0E+100) AND (TARGET_PROPORTIONAL_GAIN &lt;= 1.0E+100) AND (TARGET_INTEGRAL_GAIN &gt;= -1.0E+100) AND (TARGET_INTEGRAL_GAIN &lt;= 1.0E+100) AND (TARGET_DERIVATIVE_GAIN &gt;= -1.0E+100) AND (TARGET_DERIVATIVE_GAIN &lt;= 1.0E+100) AND (MODEL_OUTPUT_COEFFICIENT_1 &gt;= -1.0E+100) AND (MODEL_OUTPUT_COEFFICIENT_1 &lt;= 1.0E+100) AND (MODEL_OUTPUT_COEFFICIENT_2 &gt;= -1.0E+100) AND (MODEL_OUTPUT_COEFFICIENT_2 &lt;= 1.0E+100) AND (MODEL_INPUT_COEFFICIENT_1 &gt;= -1.0E+100) AND (MODEL_INPUT_COEFFICIENT_1 &lt;= 1.0E+100) AND (MODEL_INPUT_COEFFICIENT_2 &gt;= -1.0E+100) AND (MODEL_INPUT_COEFFICIENT_2 &lt;= 1.0E+100) AND (TARGET_PROPORTIONAL_GAIN &gt;= 0.0) AND (TARGET_INTEGRAL_GAIN &gt;= 0.0) AND (TARGET_DERIVATIVE_GAIN &gt;= 0.0);&#10;IF CANDIDATE_VALID THEN&#10;CURRENT_ERROR := SETPOINT - PROCESS_VARIABLE;&#10;NEXT_INTEGRAL := INTEGRAL_MEMORY + ACTIVE_SAMPLE_TIME_S / 2.0 * (CURRENT_ERROR + PREVIOUS_ERROR);&#10;CURRENT_DERIVATIVE := (CURRENT_ERROR - PREVIOUS_ERROR) / ACTIVE_SAMPLE_TIME_S;&#10;OLD_RAW := ACTIVE_PROPORTIONAL_GAIN * CURRENT_ERROR + ACTIVE_INTEGRAL_GAIN * NEXT_INTEGRAL + ACTIVE_DERIVATIVE_GAIN * CURRENT_DERIVATIVE;&#10;DELTA_P := TARGET_PROPORTIONAL_GAIN - ACTIVE_PROPORTIONAL_GAIN;&#10;DELTA_I := TARGET_INTEGRAL_GAIN - ACTIVE_INTEGRAL_GAIN;&#10;DELTA_D := TARGET_DERIVATIVE_GAIN - ACTIVE_DERIVATIVE_GAIN;&#10;FULL_EFFECT := DELTA_P * CURRENT_ERROR + DELTA_I * NEXT_INTEGRAL + DELTA_D * CURRENT_DERIVATIVE;&#10;CANDIDATE_VALID := (CURRENT_ERROR &gt;= -1.0E+100) AND (CURRENT_ERROR &lt;= 1.0E+100) AND (NEXT_INTEGRAL &gt;= -1.0E+100) AND (NEXT_INTEGRAL &lt;= 1.0E+100) AND (CURRENT_DERIVATIVE &gt;= -1.0E+100) AND (CURRENT_DERIVATIVE &lt;= 1.0E+100) AND (OLD_RAW &gt;= -1.0E+100) AND (OLD_RAW &lt;= 1.0E+100) AND (FULL_EFFECT &gt;= -1.0E+100) AND (FULL_EFFECT &lt;= 1.0E+100) AND (OLD_RAW &gt;= ACTIVE_OUTPUT_MIN) AND (OLD_RAW &lt;= ACTIVE_OUTPUT_MAX);&#10;IF CANDIDATE_VALID THEN&#10;STEP_FRACTION := 1.0;&#10;MAGNITUDE := FULL_EFFECT;&#10;IF MAGNITUDE &lt; 0.0 THEN&#10;MAGNITUDE := -MAGNITUDE;&#10;END_IF;&#10;IF MAGNITUDE &gt; MAX_GAIN_OUTPUT_CHANGE THEN&#10;STEP_FRACTION := MAX_GAIN_OUTPUT_CHANGE / MAGNITUDE;&#10;END_IF;&#10;SCALE := ACTIVE_PROPORTIONAL_GAIN;&#10;IF SCALE &lt; 0.0 THEN&#10;SCALE := -SCALE;&#10;END_IF;&#10;IF SCALE &lt; PROPORTIONAL_SCALE_FLOOR THEN&#10;SCALE := PROPORTIONAL_SCALE_FLOOR;&#10;END_IF;&#10;MAGNITUDE := DELTA_P;&#10;IF MAGNITUDE &lt; 0.0 THEN&#10;MAGNITUDE := -MAGNITUDE;&#10;END_IF;&#10;RELATIVE_STEP := MAGNITUDE / SCALE;&#10;IF RELATIVE_STEP &gt; MAX_RELATIVE_GAIN_STEP THEN&#10;FRACTION_LIMIT := MAX_RELATIVE_GAIN_STEP / RELATIVE_STEP;&#10;IF FRACTION_LIMIT &lt; STEP_FRACTION THEN&#10;STEP_FRACTION := FRACTION_LIMIT;&#10;END_IF;&#10;END_IF;&#10;CANDIDATE_P := ACTIVE_PROPORTIONAL_GAIN + STEP_FRACTION * DELTA_P;&#10;SCALE := ACTIVE_INTEGRAL_GAIN;&#10;IF SCALE &lt; 0.0 THEN&#10;SCALE := -SCALE;&#10;END_IF;&#10;IF SCALE &lt; INTEGRAL_SCALE_FLOOR THEN&#10;SCALE := INTEGRAL_SCALE_FLOOR;&#10;END_IF;&#10;MAGNITUDE := DELTA_I;&#10;IF MAGNITUDE &lt; 0.0 THEN&#10;MAGNITUDE := -MAGNITUDE;&#10;END_IF;&#10;RELATIVE_STEP := MAGNITUDE / SCALE;&#10;IF RELATIVE_STEP &gt; MAX_RELATIVE_GAIN_STEP THEN&#10;FRACTION_LIMIT := MAX_RELATIVE_GAIN_STEP / RELATIVE_STEP;&#10;IF FRACTION_LIMIT &lt; STEP_FRACTION THEN&#10;STEP_FRACTION := FRACTION_LIMIT;&#10;END_IF;&#10;END_IF;&#10;CANDIDATE_I := ACTIVE_INTEGRAL_GAIN + STEP_FRACTION * DELTA_I;&#10;SCALE := ACTIVE_DERIVATIVE_GAIN;&#10;IF SCALE &lt; 0.0 THEN&#10;SCALE := -SCALE;&#10;END_IF;&#10;IF SCALE &lt; DERIVATIVE_SCALE_FLOOR THEN&#10;SCALE := DERIVATIVE_SCALE_FLOOR;&#10;END_IF;&#10;MAGNITUDE := DELTA_D;&#10;IF MAGNITUDE &lt; 0.0 THEN&#10;MAGNITUDE := -MAGNITUDE;&#10;END_IF;&#10;RELATIVE_STEP := MAGNITUDE / SCALE;&#10;IF RELATIVE_STEP &gt; MAX_RELATIVE_GAIN_STEP THEN&#10;FRACTION_LIMIT := MAX_RELATIVE_GAIN_STEP / RELATIVE_STEP;&#10;IF FRACTION_LIMIT &lt; STEP_FRACTION THEN&#10;STEP_FRACTION := FRACTION_LIMIT;&#10;END_IF;&#10;END_IF;&#10;CANDIDATE_D := ACTIVE_DERIVATIVE_GAIN + STEP_FRACTION * DELTA_D;&#10;CANDIDATE_P := ACTIVE_PROPORTIONAL_GAIN + STEP_FRACTION * DELTA_P;&#10;CANDIDATE_I := ACTIVE_INTEGRAL_GAIN + STEP_FRACTION * DELTA_I;&#10;CANDIDATE_D := ACTIVE_DERIVATIVE_GAIN + STEP_FRACTION * DELTA_D;&#10;NEW_RAW := CANDIDATE_P * CURRENT_ERROR + CANDIDATE_I * NEXT_INTEGRAL + CANDIDATE_D * CURRENT_DERIVATIVE;&#10;Q0 := CANDIDATE_P + CANDIDATE_I * ACTIVE_SAMPLE_TIME_S / 2.0 + CANDIDATE_D / ACTIVE_SAMPLE_TIME_S;&#10;Q1 := -CANDIDATE_P + CANDIDATE_I * ACTIVE_SAMPLE_TIME_S / 2.0 - 2.0 * CANDIDATE_D / ACTIVE_SAMPLE_TIME_S;&#10;Q2 := CANDIDATE_D / ACTIVE_SAMPLE_TIME_S;&#10;A1 := -1.0 - MODEL_OUTPUT_COEFFICIENT_1 + MODEL_INPUT_COEFFICIENT_1 * Q0;&#10;A2 := MODEL_OUTPUT_COEFFICIENT_1 - MODEL_OUTPUT_COEFFICIENT_2 + MODEL_INPUT_COEFFICIENT_1 * Q1 + MODEL_INPUT_COEFFICIENT_2 * Q0;&#10;A3 := MODEL_OUTPUT_COEFFICIENT_2 + MODEL_INPUT_COEFFICIENT_1 * Q2 + MODEL_INPUT_COEFFICIENT_2 * Q1;&#10;A4 := MODEL_INPUT_COEFFICIENT_2 * Q2;&#10;CANDIDATE_VALID := (CANDIDATE_P &gt;= -1.0E+100) AND (CANDIDATE_P &lt;= 1.0E+100) AND (CANDIDATE_I &gt;= -1.0E+100) AND (CANDIDATE_I &lt;= 1.0E+100) AND (CANDIDATE_D &gt;= -1.0E+100) AND (CANDIDATE_D &lt;= 1.0E+100) AND (NEW_RAW &gt;= -1.0E+100) AND (NEW_RAW &lt;= 1.0E+100) AND (A1 &gt;= -1.0E+100) AND (A1 &lt;= 1.0E+100) AND (A2 &gt;= -1.0E+100) AND (A2 &lt;= 1.0E+100) AND (A3 &gt;= -1.0E+100) AND (A3 &lt;= 1.0E+100) AND (A4 &gt;= -1.0E+100) AND (A4 &lt;= 1.0E+100) AND (NEW_RAW &gt;= ACTIVE_OUTPUT_MIN) AND (NEW_RAW &lt;= ACTIVE_OUTPUT_MAX);&#10;IF CANDIDATE_VALID THEN&#10;CANDIDATE_VALID := (A4 &gt; -1.0) AND (A4 &lt; 1.0);&#10;IF CANDIDATE_VALID THEN&#10;DENOMINATOR := 1.0 - A4 * A4;&#10;CANDIDATE_VALID := DENOMINATOR &gt; 1.0E-12;&#10;IF CANDIDATE_VALID THEN&#10;B1 := (A1 - A4 * A3) / DENOMINATOR;&#10;B2 := (A2 - A4 * A2) / DENOMINATOR;&#10;B3 := (A3 - A4 * A1) / DENOMINATOR;&#10;CANDIDATE_VALID := (B1 &gt;= -1.0E+100) AND (B1 &lt;= 1.0E+100) AND (B2 &gt;= -1.0E+100) AND (B2 &lt;= 1.0E+100) AND (B3 &gt;= -1.0E+100) AND (B3 &lt;= 1.0E+100);&#10;END_IF;&#10;END_IF;&#10;END_IF;&#10;IF CANDIDATE_VALID THEN&#10;CANDIDATE_VALID := (B3 &gt; -1.0) AND (B3 &lt; 1.0);&#10;IF CANDIDATE_VALID THEN&#10;DENOMINATOR := 1.0 - B3 * B3;&#10;CANDIDATE_VALID := DENOMINATOR &gt; 1.0E-12;&#10;IF CANDIDATE_VALID THEN&#10;C1 := (B1 - B3 * B2) / DENOMINATOR;&#10;C2 := (B2 - B3 * B1) / DENOMINATOR;&#10;CANDIDATE_VALID := (C1 &gt;= -1.0E+100) AND (C1 &lt;= 1.0E+100) AND (C2 &gt;= -1.0E+100) AND (C2 &lt;= 1.0E+100);&#10;END_IF;&#10;END_IF;&#10;END_IF;&#10;IF CANDIDATE_VALID THEN&#10;CANDIDATE_VALID := (C2 &gt; -1.0) AND (C2 &lt; 1.0);&#10;IF CANDIDATE_VALID THEN&#10;DENOMINATOR := 1.0 - C2 * C2;&#10;CANDIDATE_VALID := DENOMINATOR &gt; 1.0E-12;&#10;IF CANDIDATE_VALID THEN&#10;D1 := (C1 - C2 * C1) / DENOMINATOR;&#10;CANDIDATE_VALID := (D1 &gt;= -1.0E+100) AND (D1 &lt;= 1.0E+100);&#10;END_IF;&#10;END_IF;&#10;END_IF;&#10;IF CANDIDATE_VALID THEN&#10;CANDIDATE_VALID := (D1 &gt; -1.0) AND (D1 &lt; 1.0);&#10;END_IF;&#10;IF CANDIDATE_VALID THEN&#10;NEXT_PROPORTIONAL_GAIN := CANDIDATE_P;&#10;NEXT_INTEGRAL_GAIN := CANDIDATE_I;&#10;NEXT_DERIVATIVE_GAIN := CANDIDATE_D;&#10;GAIN_OUTPUT_CHANGE := NEW_RAW - OLD_RAW;&#10;UPDATE_APPLIED := (DELTA_P &lt;&gt; 0.0) OR (DELTA_I &lt;&gt; 0.0) OR (DELTA_D &lt;&gt; 0.0);&#10;END_IF;&#10;IF NOT CANDIDATE_VALID THEN&#10;STEP_FRACTION := 0.0;&#10;END_IF;&#10;END_IF;&#10;END_IF;&#10;END_IF;&#10;END_IF;" />
    </Algorithm>
  </BasicFB>
</FBType>